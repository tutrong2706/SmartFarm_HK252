# Gateway Environment Configuration (.env.example)
# ==================================================
# Copy file này thành .env và điền thông tin thực tế

# Adafruit IO Credentials (Lấy từ https://io.adafruit.com)
ADAFRUIT_IO_USERNAME=your_adafruit_username
ADAFRUIT_IO_KEY=your_adafruit_aio_key
OWNER_USERNAME=your_secondary_adafruit_username_if_needed

# Backend API Configuration
BACKEND_URL=http://localhost:8000
TELEMETRY_URL=http://localhost:8000/api/telemetry

# Optional: Interval (giây)
INTERVAL_SEC=10
