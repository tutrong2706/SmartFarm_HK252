# Backend Environment Variables
# ================================

# JWT Secret Key (Giữ bí mật! Không commit lên GitHub)
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_farm_db

# FastAPI
ENVIRONMENT=development
DEBUG=True

# Adafruit IO Credentials (Cần có tài khoản https://io.adafruit.com)
ADAFRUIT_IO_USERNAME=your_adafruit_username_here
ADAFRUIT_IO_KEY=your_adafruit_aio_key_here
OWNER_USERNAME=your_secondary_adafruit_username_if_needed

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Gemini API Configuration (Cho Chatbot & RAG)
GEMINI_API_KEY=your_gemini_api_key_from_https://aistudio.google.com
